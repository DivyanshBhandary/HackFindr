GEMINI_API_KEY=paste-your-key-here

# Optional settings. Remove the # to use one.
# GEMMA_MODEL=gemma-4-26b-a4b-it
# MIN_SECONDS_BETWEEN_CALLS=4
# GEMMA_CACHE=1
# GEMMA_SOFT_LIMIT=1000

# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:7860/auth  (or your HTTPS address + /auth)
# Without these, a local "Sign in (demo)" button is shown instead.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# HACKFINDR_PUBLIC_URL=https://your-tunnel-or-domain
# SESSION_SECRET=any-long-random-text

# Reminder emails (optional). For Gmail: your address and a 16-letter App password
# (Google Account > Security > 2-Step Verification > App passwords). Without these,
# emails are saved to data/outbox/ instead of being sent.
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=abcd efgh ijkl mnop
# REMINDER_CHECK_MINUTES=60

# Usage stats page (/stats?key=...). Made automatically in data/stats_key.txt if not set.
# STATS_KEY=any-random-text

# Public HTTPS link through ngrok (python app.py --tunnel). Free account at https://ngrok.com:
# token from the dashboard, your free domain from dashboard.ngrok.com/domains.
# Also set HACKFINDR_PUBLIC_URL=https://<your domain> and add https://<your domain>/auth in Google Cloud Console.
# NGROK_AUTHTOKEN=
# NGROK_DOMAIN=your-name.ngrok-free.dev
