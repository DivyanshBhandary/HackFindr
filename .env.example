GEMINI_API_KEY=paste-your-key-here

# Optional settings. Remove the # to use one.
# GEMMA_MODEL=gemma-4-26b-a4b-it
# MIN_SECONDS_BETWEEN_CALLS=4
# GEMMA_CACHE=1
# GEMMA_SOFT_LIMIT=1000

# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:7860/auth  (or your HTTPS address + /auth)
# Without these, a local "Sign in (demo)" button is shown instead.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# HACKFINDR_PUBLIC_URL=https://your-tunnel-or-domain
# SESSION_SECRET=any-long-random-text
